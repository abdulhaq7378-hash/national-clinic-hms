# National Clinic HMS configuration
# Copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# MongoDB connection string. Production must use a replica set
# (MongoDB Atlas, or a self-hosted single-node replica set).
# Use MONGODB_URI=memory for a throwaway in-memory database with demo data
# (development only; this is what `npm run dev:demo` does).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=national_clinic

# Signing secret for access tokens. Generate one with: npm run generate-secret
# Required in production (at least 32 characters).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Send the session cookie only over HTTPS. Defaults to true in production.
# COOKIE_SECURE=true

# Number of reverse proxies in front of the API (for correct client IPs), e.g. 1 behind Nginx.
TRUST_PROXY=0

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional: serve the built HMS frontend from the API server (same origin).
# SERVE_WEB_DIST=../hms/dist

# Optional: create the first administrator automatically on first start.
# Remove these values after the account exists.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Development only: password for the demo accounts. When empty, a random
# password is generated and printed in the server log on every start.
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# HMS frontend (Vite). Only variables starting with VITE_ reach the browser.
# ---------------------------------------------------------------------------
# API base URL. Leave as /api when the API is served from the same origin
# (the Vite dev server proxies /api to the server).
VITE_API_URL=/api
# Where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY=http://localhost:4000
